[
  {
    "metadata": {
      "id": "evan.aiostreams.setup",
      "name": "Evan's AIOStreams Setup",
      "description": "Evan's personal AIOStreams setup: TorBox + Torrin (via StremThru) + Usenet through the built-in NNTP engine, NZBNest and Hashnab Newznab indexers, Comet/Torrentio/MediaFusion/StremThru Torz scrapers, Zilean on alderaan, cached-first sorting with the Library pinned high, and the Redhair777 2160p Remux SEL + regex lists synced.",
      "author": "Evan",
      "source": "custom",
      "version": "1.0.0",
      "category": "AIO",
      "serviceRequired": false,
      "services": [
        "torbox",
        "torrin",
        "aiostreams"
      ],
      "inputs": [
        {
          "id": "indexers",
          "name": "Usenet Indexers",
          "description": "NZBNest and Hashnab Newznab indexers. Each indexer is added twice \u2014 once for ID-based (Auto) search and once for title-text (Query) search \u2014 so NZBs surface whether or not the indexer supports ID lookups. Fill in an API key to include that indexer; leave it blank to skip it.",
          "type": "subsection",
          "required": false,
          "subOptions": [
            {
              "id": "nzbnest",
              "name": "NZBNest",
              "description": "NZBNest Newznab indexer.",
              "type": "nab-endpoint",
              "required": false,
              "nab": {
                "namespace": "newznab"
              },
              "subOptions": [
                {
                  "id": "url",
                  "name": "NZBNest URL",
                  "description": "Full Newznab API endpoint URL, usually ending in /api.",
                  "type": "select-with-custom",
                  "required": false,
                  "options": [
                    {
                      "label": "NzbNest",
                      "value": "https://nzbnest.com/api",
                      "apiKeyUrl": "https://nzbnest.com/profile"
                    }
                  ],
                  "default": "https://nzbnest.com/api"
                },
                {
                  "id": "apiKey",
                  "name": "API Key",
                  "description": "Your NZBNest API key. Leave blank to skip NZBNest.",
                  "type": "password",
                  "required": false
                }
              ]
            },
            {
              "id": "hashnab",
              "name": "Hashnab",
              "description": "Hashnab Newznab indexer.",
              "type": "nab-endpoint",
              "required": false,
              "nab": {
                "namespace": "newznab"
              },
              "subOptions": [
                {
                  "id": "url",
                  "name": "Hashnab URL",
                  "description": "Full Newznab API endpoint URL, usually ending in /api.",
                  "type": "url",
                  "required": false
                },
                {
                  "id": "apiKey",
                  "name": "API Key",
                  "description": "Your Hashnab API key. Leave blank to skip Hashnab.",
                  "type": "password",
                  "required": false
                }
              ]
            }
          ]
        },
        {
          "id": "indexerNote",
          "name": "NNTP providers",
          "description": "Usenet results are fetched through the built-in AIOStreams NNTP engine, so add your NNTP providers under Dashboard -> Usenet -> Providers after applying (providers are instance-level and cannot be part of a template).",
          "type": "alert",
          "intent": "info"
        },
        {
          "id": "localAddons",
          "name": "Local Addons",
          "description": "Zilean runs on alderaan. Leave the URL as-is unless it moved.",
          "type": "subsection",
          "required": false,
          "subOptions": [
            {
              "id": "zileanUrl",
              "name": "Zilean URL",
              "description": "Base URL of your Zilean instance.",
              "type": "url",
              "required": false,
              "default": "http://192.168.68.64:8181"
            }
          ]
        },
        {
          "id": "metaApis",
          "name": "Metadata APIs",
          "description": "Keys used for posters and metadata lookups. TMDB is strongly recommended.",
          "type": "subsection",
          "required": false,
          "subOptions": [
            {
              "id": "tmdbApiKey",
              "name": "TMDB API Key",
              "description": "Your TMDB API key.",
              "type": "password",
              "required": false
            },
            {
              "id": "tvdbApiKey",
              "name": "TVDB API Key",
              "description": "Your TVDB API key (optional).",
              "type": "password",
              "required": false
            }
          ]
        },
        {
          "id": "aiometa",
          "name": "AIOMetadata (optional)",
          "description": "Cross-ID metadata addon. Paste the manifest URL only if you run AIOMetadata; otherwise leave blank and the addon entry is skipped.",
          "type": "subsection",
          "required": false,
          "subOptions": [
            {
              "id": "aiometaUrl",
              "name": "AIOMetadata manifest URL",
              "description": "Full manifest URL of your AIOMetadata instance.",
              "type": "url",
              "required": false
            }
          ]
        }
      ]
    },
    "config": {
      "preferredLanguages": [
        "English"
      ],
      "tmdbApiKey": {
        "__if": "inputs.metaApis.tmdbApiKey",
        "__value": "{{inputs.metaApis.tmdbApiKey}}"
      },
      "tvdbApiKey": {
        "__if": "inputs.metaApis.tvdbApiKey",
        "__value": "{{inputs.metaApis.tvdbApiKey}}"
      },
      "presets": [
        {
          "__if": "inputs.indexers.nzbnest.apiKey",
          "type": "newznab",
          "instanceId": "e9a8b5be-eb71-4b1c-8e42-a311c143ac46",
          "enabled": true,
          "options": {
            "name": "NZBNest",
            "api": "{{inputs.indexers.nzbnest}}",
            "timeout": 15000,
            "mediaTypes": [],
            "services": [
              "aiostreams"
            ],
            "searchMode": "both",
            "seasonEpisodeStrategy": "dynamic",
            "paginate": true,
            "useMultipleInstances": false
          },
          "category": "Usenet"
        },
        {
          "__if": "inputs.indexers.hashnab.apiKey",
          "type": "newznab",
          "instanceId": "41e22f06-4ca5-4212-9259-df662c1ebcc9",
          "enabled": true,
          "options": {
            "name": "Hashnab",
            "api": "{{inputs.indexers.hashnab}}",
            "timeout": 15000,
            "mediaTypes": [],
            "services": [
              "aiostreams"
            ],
            "searchMode": "both",
            "seasonEpisodeStrategy": "dynamic",
            "paginate": true,
            "useMultipleInstances": false
          },
          "category": "Usenet"
        },
        {
          "type": "comet",
          "instanceId": "faf56a54-4e3a-4240-8a4a-0e6c55c9e8b8",
          "enabled": true,
          "options": {
            "name": "Comet",
            "timeout": 5000,
            "resources": [
              "stream"
            ],
            "mediaTypes": [],
            "includeP2P": true,
            "removeTrash": true,
            "useMultipleInstances": false
          },
          "category": "Debrid"
        },
        {
          "type": "torrentio",
          "instanceId": "71918c25-cccf-400d-83df-9c5a1ea0f0ca",
          "enabled": true,
          "options": {
            "name": "Torrentio",
            "timeout": 5000,
            "resources": [
              "stream"
            ],
            "mediaTypes": [],
            "providers": [],
            "useMultipleInstances": false
          },
          "category": "Debrid"
        },
        {
          "type": "mediafusion",
          "instanceId": "ba4aad21-74b2-4c43-a826-9b9e0bc17320",
          "enabled": true,
          "options": {
            "name": "MediaFusion",
            "timeout": 5000,
            "resources": [
              "stream"
            ],
            "mediaTypes": [],
            "useCachedResultsOnly": true,
            "enableWatchlistCatalogs": false,
            "downloadViaBrowser": false,
            "contributorStreams": false,
            "certificationLevelsFilter": [],
            "nudityFilter": [],
            "includeP2P": true,
            "useMultipleInstances": false
          },
          "category": "Debrid"
        },
        {
          "type": "stremthruTorz",
          "instanceId": "83a71c5a-a218-4e43-bd4d-bfd81a82ccbf",
          "enabled": true,
          "options": {
            "name": "StremThru Torz",
            "timeout": 5000,
            "resources": [
              "stream"
            ],
            "mediaTypes": [],
            "includeP2P": true,
            "useMultipleInstances": false
          },
          "category": "Debrid"
        },
        {
          "type": "zilean",
          "instanceId": "0c849f0e-b5dc-44ec-8eff-92bfc925cdab",
          "enabled": true,
          "options": {
            "name": "Zilean",
            "url": "{{inputs.localAddons.zileanUrl}}",
            "timeout": 5000,
            "mediaTypes": [],
            "useMultipleInstances": false
          },
          "category": "Debrid"
        },
        {
          "type": "torbox",
          "instanceId": "55136704-4d2d-4dbb-adc2-1de6af15015c",
          "enabled": true,
          "options": {
            "name": "TorBox",
            "timeout": 5000,
            "resources": [
              "stream",
              "meta",
              "catalog"
            ],
            "mediaTypes": []
          },
          "category": "Debrid"
        },
        {
          "type": "library",
          "instanceId": "861e90ed-7a43-45ae-994b-5b1af04156d2",
          "enabled": true,
          "options": {
            "name": "Library",
            "timeout": 5000,
            "resources": [
              "catalog",
              "meta",
              "stream"
            ],
            "mediaTypes": [],
            "showRefreshActions": true,
            "skipProcessing": false,
            "hideStreams": false,
            "useMultipleInstances": false
          },
          "category": "Library"
        },
        {
          "__if": "inputs.aiometa.aiometaUrl",
          "type": "custom",
          "instanceId": "ac4d357b-298a-463f-b7b7-1d97001f9cce",
          "enabled": true,
          "options": {
            "name": "AIOMetadata",
            "manifestUrl": "{{inputs.aiometa.aiometaUrl}}",
            "timeout": 5000,
            "resources": [
              "meta",
              "catalog"
            ],
            "mediaTypes": []
          },
          "category": "Metadata"
        }
      ],
      "syncedRankedStreamExpressionUrls": [
        "https://raw.githubusercontent.com/redhair777/aio-quality-profiles/main/profiles/2160p-remux.expressions.json"
      ],
      "syncedRankedRegexUrls": [
        "https://raw.githubusercontent.com/redhair777/aio-quality-profiles/main/profiles/2160p-remux.regexes.json"
      ],
      "sortCriteria": {
        "global": [
          {
            "key": "cached",
            "direction": "desc"
          }
        ],
        "cached": [
          {
            "key": "library",
            "direction": "desc"
          },
          {
            "key": "service",
            "direction": "desc"
          },
          {
            "key": "resolution",
            "direction": "desc"
          },
          {
            "key": "quality",
            "direction": "desc"
          },
          {
            "key": "streamExpressionScore",
            "direction": "desc"
          },
          {
            "key": "language",
            "direction": "desc"
          },
          {
            "key": "encode",
            "direction": "desc"
          },
          {
            "key": "bitrate",
            "direction": "desc"
          }
        ],
        "uncached": [
          {
            "key": "resolution",
            "direction": "desc"
          },
          {
            "key": "quality",
            "direction": "desc"
          },
          {
            "key": "streamExpressionScore",
            "direction": "desc"
          },
          {
            "key": "language",
            "direction": "desc"
          },
          {
            "key": "encode",
            "direction": "desc"
          },
          {
            "key": "bitrate",
            "direction": "desc"
          }
        ]
      },
      "formatter": {
        "id": "custom",
        "definitions": {
          "custom": {
            "name": "{stream.title} | {stream.resolution} {stream.quality} | {stream.size} | {stream.languages} | SEL:{stream.seScore}",
            "description": "Matched: {stream.rseMatched} | {stream.visualTags} {stream.audioTags} | {stream.releaseGroup} | {stream.bitrate} | via {stream.indexer}"
          }
        }
      },
      "failover": {
        "enabled": true,
        "contentTypes": [
          "usenet",
          "debrid"
        ],
        "allowCrossType": true,
        "maxAttempts": 5,
        "parallel": 2,
        "position": "beforeLimiting",
        "includeExternalFailover": true,
        "sameReleaseLimit": 2,
        "precacheFailover": false
      },
      "deduplicator": {
        "enabled": true,
        "excludeAddons": [],
        "multiGroupBehaviour": "aggressive",
        "keys": [
          "filename",
          "infoHash",
          "smartDetect"
        ],
        "cached": "single_result",
        "uncached": "single_result",
        "p2p": "single_result",
        "http": "per_addon",
        "smartDetectAttributes": [
          "size",
          "resolution",
          "quality",
          "visualTags",
          "audioTags",
          "audioChannels",
          "languages",
          "encode",
          "edition",
          "network",
          "remastered",
          "bitrate",
          "releaseGroup"
        ],
        "smartDetectRounding": 10,
        "libraryBehaviour": "prefer",
        "merge": {
          "enabled": true,
          "failoverVariants": true,
          "fields": [
            "sizes",
            "seadex",
            "library",
            "subtitles",
            "languages"
          ]
        }
      },
      "cacheAndPlay": {
        "enabled": true,
        "streamTypes": [
          "usenet"
        ]
      },
      "checkOwned": true
    }
  }
]
